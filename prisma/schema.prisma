
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("STORAGE_DATABASE_URL")
}

model Experience {
  id          String    @id @default(cuid())
  company     String
  position    String
  employmentType String?
  description String    @db.Text
  startDate   DateTime
  endDate     DateTime?
  technologies String[] @default([])
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, startDate])
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @db.Text
  imageUrl    String?
  githubUrl   String?
  demoUrl     String?
  technologies String[] @default([])
  isFeatured  Boolean  @default(false)
  isPublished Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  role        String?
  images      String[] @default([])

  @@index([isPublished, isFeatured])
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEW_SCHEDULED
  INTERVIEWED
  OFFER
  REJECTED
  WITHDRAWN
}

model Company {
  id           String        @id @default(cuid())
  name         String
  website      String?
  location     String?
  applications Application[]
}

model Application {
  id          String            @id @default(cuid())
  company     Company           @relation(fields: [companyId], references: [id])
  companyId   String
  position    String
  status      ApplicationStatus @default(APPLIED)
  appliedAt   DateTime          @default(now())
  channel     String?           // JobsDB, LinkedIn, อีเมล ฯลฯ
  jobUrl      String?
  salaryRange String?
  notes       String?           @db.Text
  interviews  Interview[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Interview {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  scheduledAt   DateTime
  type          String?     // online / onsite / phone
  location      String?     // ลิงก์ Meet/Zoom หรือที่อยู่
  round         Int         @default(1)
  feedback      String?     @db.Text
}

model AdminUser {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
}
